# GEMINI_API_KEY: Required for AI Assist and Pro Quality modes.
# Never commit a real key. Pass your key through the app UI (BYOK).
# In local dev you can also set it here, but .env is gitignored.
GEMINI_API_KEY=

# GEMINI_MODEL: Optional. Override the Gemini model used for generation.
# Default: gemini-2.5-flash  (fast, cost-effective, good quality)
# Other options: gemini-2.0-flash, gemini-1.5-flash, gemini-2.5-pro
# To change the default permanently, edit agents/gemini_client.py:_DEFAULT_MODEL
GEMINI_MODEL=

# APP_URL: The URL where this app is hosted (used for self-referential links).
APP_URL=
